DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>
REDIS_URL=redis://<host>:<port>
# Optional: Supabase Storage for Thumbnails (the private `thumbnails` bucket). Without both, Items get no Thumbnails.
# The service role key bypasses row-level security: server only, never in anything public.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
