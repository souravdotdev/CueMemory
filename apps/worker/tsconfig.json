{
  "extends": "@cue-memory/typescript-config/library.json",
  "compilerOptions": {
    "outDir": "dist",
    // InversifyJS's @injectable/@inject are legacy (parameter) decorators.
    // No emitDecoratorMetadata: esbuild (tsup, tsx) can't emit it, so every
    // constructor parameter names its token with @inject(WORKER_TOKENS.X).
    "experimentalDecorators": true,
    // The `@/` alias: tsc and tsx read it here, tsup (esbuild) too; Vitest mirrors it.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
